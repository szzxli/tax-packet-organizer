  "ai_scope": {
    "note": "AI 清单的语义闸门：只有描述里出现 when 里的情形，这张表才允许出现；reject 里的词只要出现在描述或模型给的 payer/why/prepare 里，这条直接丢。不在本表里的表不受这两条约束（W-2、1099-INT 这类常见收入表）。",
    "1098": {"when": ["房贷", "按揭", "mortgage", "home loan", "housing loan"], "reject": ["大学", "学费", "tuition", "college", "university", "学校"]},
    "1098-T": {"when": ["学费", "大学", "college", "university", "tuition", "学校", "在读", "孩子上"], "reject": []},
    "1098-E": {"when": ["学生贷款", "助学贷款", "student loan"], "reject": []},
    "1099-MISC": {"when": ["租金", "rent", "稿费", "royalt", "奖金", "prize", "其他收入", "other income"], "reject": ["uber", "lyft", "滴滴", "网约车", "外卖", "doordash", "instacart", "接单"]},
    "1099-NEC": {"when": ["自雇", "self-employ", "freelanc", "接单", "uber", "lyft", "doordash", "instacart", "contract", "副业", "1099-nec"], "reject": []},
    "1099-K": {"when": ["uber", "lyft", "平台", "platform", "paypal", "venmo", "ebay", "etsy", "收款", "gig"], "reject": []},
    "Schedule C": {"when": ["自雇", "self-employ", "freelanc", "副业", "接单", "uber", "lyft", "doordash", "instacart", "生意", "business", "现金收入", "cash"], "reject": []},
    "Schedule E": {"when": ["房租", "出租", "租金", "rental", "rent"], "reject": []},
    "房产税单": {"when": ["房", "property", "房贷", "出租"], "reject": []}
  },
